# Copia este archivo como .streamlit/secrets.toml (NO lo subas al repositorio) o pega su contenido
# en Settings → Secrets de Streamlit Community Cloud.

# 1) Autenticación OIDC (ejemplo con Google). Sin esta sección la app funciona como vista pública.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "cambia-esta-cadena-larga-y-aleatoria"
client_id = "TU_CLIENT_ID.apps.googleusercontent.com"
client_secret = "TU_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# 2) Autorización: correo verificado → rol (planificacion, experiencia, operacion, admin).
[roles]
"laura@ejemplo.com" = "planificacion"
"armando@ejemplo.com" = "experiencia"
"anna@ejemplo.com" = "operacion"

# 3) Sal secreta para seudonimizar Customer_ID en listas restringidas.
pseudonym_salt = "otra-cadena-larga-y-aleatoria"
